    "otlp": {"description": "belongs to dog-k8s-collector; rejected with a hint by the templates"},
    "journald": {"description": "belongs to dog-k8s-collector; rejected with a hint by the templates"},
    "kubernetesAttributes": {"description": "belongs to dog-k8s-collector; rejected with a hint by the templates"},
    "resourceDetection": {"description": "belongs to dog-k8s-collector; rejected with a hint by the templates"},
    "clusterName": {"description": "belongs to dog-k8s-collector; rejected with a hint by the templates"},
    "platform": {"description": "belongs to dog-k8s-collector; rejected with a hint by the templates"},
    "presets": {"description": "belongs to dog-k8s-collector; rejected with a hint by the templates"},
    "otel": {"description": "chart 0.1.x key, rejected with a migration hint by the templates"},
