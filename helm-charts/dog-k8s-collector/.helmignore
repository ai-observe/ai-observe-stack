# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Repo-level test dirs (templates/tests/ holds the helm test hook and must stay)
/tests/
/test/
# Extra files
request.md
# Large asset directories (these are mounted via hostPath, not included in chart)
grafana/
images/